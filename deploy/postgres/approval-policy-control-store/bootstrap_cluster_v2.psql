\set ON_ERROR_STOP on

-- Required psql variables:
--   control_database: dedicated database name
--   owner_role:       dedicated NOLOGIN owner
--   reader_role:      dedicated LOGIN role for identity/current-state reads
--   activator_role:   dedicated LOGIN role for reads plus exact policy CAS activation
--   attempt_issuer_role: dedicated LOGIN role for reads plus durable attempt issuance
--   fencer_role:      dedicated LOGIN role for reads plus exact execution-fence opening
--
-- This is the create-only bootstrap for schema format 2. Re-running it must fail instead of
-- adopting an existing role or database. Use upgrade_cluster_v1_to_v2.psql for an attested v1
-- cluster; never point this script at an existing deployment.

CREATE ROLE :"owner_role"
    NOLOGIN NOSUPERUSER NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION NOBYPASSRLS
    CONNECTION LIMIT -1;

CREATE ROLE :"reader_role"
    LOGIN NOSUPERUSER NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION NOBYPASSRLS
    CONNECTION LIMIT -1;

CREATE ROLE :"activator_role"
    LOGIN NOSUPERUSER NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION NOBYPASSRLS
    CONNECTION LIMIT -1;

CREATE ROLE :"attempt_issuer_role"
    LOGIN NOSUPERUSER NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION NOBYPASSRLS
    CONNECTION LIMIT -1;

CREATE ROLE :"fencer_role"
    LOGIN NOSUPERUSER NOINHERIT NOCREATEROLE NOCREATEDB NOREPLICATION NOBYPASSRLS
    CONNECTION LIMIT -1;

CREATE DATABASE :"control_database"
    OWNER :"owner_role"
    TEMPLATE template0
    ENCODING 'UTF8';

REVOKE ALL ON DATABASE :"control_database" FROM PUBLIC;
REVOKE ALL ON DATABASE :"control_database" FROM :"reader_role";
REVOKE ALL ON DATABASE :"control_database" FROM :"activator_role";
REVOKE ALL ON DATABASE :"control_database" FROM :"attempt_issuer_role";
REVOKE ALL ON DATABASE :"control_database" FROM :"fencer_role";
GRANT CONNECT ON DATABASE :"control_database" TO :"reader_role";
GRANT CONNECT ON DATABASE :"control_database" TO :"activator_role";
GRANT CONNECT ON DATABASE :"control_database" TO :"attempt_issuer_role";
GRANT CONNECT ON DATABASE :"control_database" TO :"fencer_role";
