# Local model configuration template.
# Copy this file to .env and set the secret locally. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://wanapi-dev.wanmol.com:29527/v1
OPENAI_MODEL=gpt-5.6-sol

# The current product-trial server is a deterministic synthetic demo and does not
# consume these variables yet. They are reserved for the explicit OpenAI provider
# composition root; the application must fail closed rather than silently falling
# back to a different provider when that runtime is enabled.
