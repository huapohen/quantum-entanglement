# Local model configuration template.
# Copy this file to .env and set the secret locally. Never commit a real API key.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://wanapi-dev.wanmol.com:29527/v1
OPENAI_MODEL=gpt-5.6-sol

# scripts/start_local_trial.sh reads these values for the model-backed product trial.
# Use --synthetic explicitly for the deterministic offline fixture. A missing or bad
# model configuration fails closed and never silently falls back to synthetic output.
